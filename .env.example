# Which SystemOneClient implementation to use.
#   mock  — deterministic, fixture-backed answers (no network, no key needed)
#   llm   — classic LLM stand-in via Ollama Cloud (self-consistency sampling)
#   real  — the actual TypeSafe API (needs waitlist access)
TYPESAFE_PROVIDER=mock

# Provider: llm — Ollama Cloud (OpenAI-compatible endpoint).
# Use the token already authorized on this machine; never commit the real key.
OLLAMA_API_KEY=your-ollama-cloud-token
OLLAMA_MODEL=glm-5.3-flash:cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_SAMPLES=5

# Provider: real — TypeSafe AI. Set once your waitlist access is granted.
TYPESAFE_API_KEY=your-typesafe-api-key