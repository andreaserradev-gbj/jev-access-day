# Which SystemOneClient implementation to use.
#   mock  — deterministic, fixture-backed answers (no network, no key needed)
#   llm   — classic LLM stand-in via Ollama Cloud (self-consistency sampling)
#   real  — the actual TypeSafe API (needs TYPESAFE_API_KEY)
TYPESAFE_PROVIDER=mock

# ── Eval harness ──────────────────────────────────────────────────────────────
# Spend cap for `npm run eval`: abort the run once N provider requests have
# been made in a single invocation. Unset = no cap.
#EVAL_MAX_REQUESTS=100

# Provider: llm — Ollama Cloud (OpenAI-compatible endpoint).
# Use the token already authorized on this machine; never commit the real key.
OLLAMA_API_KEY=your-ollama-cloud-token
OLLAMA_MODEL=glm-5.3-flash:cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_SAMPLES=5
# Sampling temperature for each self-consistency sample (0..2). Lower is more
# deterministic; the agreement→confidence proxy weakens as it approaches 0.
OLLAMA_TEMPERATURE=0.7
# Thinking toggle for reasoning models (Ollama `think` field). Unset = omit.
#OLLAMA_THINK=false

# Provider: llm-local — the same LLM stand-in against the LOCAL Ollama daemon
# (http://localhost:11434). Defaults: qwen3.6:35b MoE, think=false, native
# /api/chat endpoint (the local daemon ignores think+format on /v1/chat).
#OLLAMA_LOCAL_MODEL=qwen3.6:35b-a3b-coding-mtp-q4_K_M
#OLLAMA_LOCAL_BASE_URL=http://localhost:11434
#OLLAMA_LOCAL_SAMPLES=5
#OLLAMA_LOCAL_TEMPERATURE=0.7
#OLLAMA_LOCAL_THINK=false
#OLLAMA_LOCAL_TIMEOUT_MS=300000

# Provider: real — TypeSafe AI via @typesafe-ai/sdk.
# The key is machine-scoped in this setup (exported from
# /run/secrets/TYPESAFE_API_KEY); put yours here instead if you prefer .env.
TYPESAFE_API_KEY=your-typesafe-api-key
# Optional overrides, passed through to the SDK client (RealProviderConfig).
# Unset TYPESAFE_BASE_URL  → SDK default https://api.typesafe.ai
# Unset TYPESAFE_DEFAULT_MODEL → SDK default jev-latest
#TYPESAFE_BASE_URL=https://api.typesafe.ai
#TYPESAFE_DEFAULT_MODEL=jev-latest